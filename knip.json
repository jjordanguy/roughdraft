{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": [
    ".codex/**",
    "packages/rfm/legacy/**",
    "packages/server/defaults.d.mts",
    "scripts/check-drive-rename.mjs"
  ],
  "ignoreDependencies": ["express", "ws", "yaml", "@roughdraft/rfm"],
  "ignoreIssues": {
    "packages/app/src/components/ui/**": ["exports", "types"]
  },
  "workspaces": {
    ".": {},
    "packages/app": {
      "entry": ["e2e/start-api.ts"]
    },
    "packages/*": {}
  }
}
